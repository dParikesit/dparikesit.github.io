---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import LinkButton from "@components/LinkButton.astro";
import Hr from "@components/Hr.astro";
import Timeline from "@components/Timeline";
import Socials from "@components/Socials.astro";
import { SOCIALS, PUBLICATION, DIMASNAMES, SERVICES } from "@config";

const socialCount = SOCIALS.filter(social => social.active).length;
---

<Layout>
  <Header />
  <main id="main-content">
    <section id="hero">
      <h1>Dimas Shidqi Parikesit</h1>
      <a
        target="_blank"
        href="/rss.xml"
        class="rss-link"
        aria-label="rss feed"
        title="RSS Feed"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="rss-icon"
          ><path
            d="M19 20.001C19 11.729 12.271 5 4 5v2c7.168 0 13 5.832 13 13.001h2z"
          ></path><path
            d="M12 20.001h2C14 14.486 9.514 10 4 10v2c4.411 0 8 3.589 8 8.001z"
          ></path><circle cx="6" cy="18" r="2"></circle>
        </svg>
        <span class="sr-only">RSS Feed</span>
      </a>

      <p>
        Hi, I'm Dimas. I'm a Computer Science PhD student at LiftLab,
        University of Virginia, advised by
        <LinkButton
          className="underline decoration-dashed underline-offset-4 hover:text-skin-accent"
          href="https://changlousys.github.io/"
        >
          Prof. Chang Lou
        </LinkButton>.
      </p>
      <p>
        My research focuses on <strong>verifying correctness of distributed systems using LLM and formal methods</strong>. I believe formal methods is the key to more reliable programs, and LLM will make it accessible to wide range of programs.
      </p>
      {
        // only display if at least one social link is enabled
        socialCount > 0 && (
          <div class="social-wrapper">
            <div class="social-links">Social Links:</div>
            <Socials />
          </div>
        )
      }
    </section>

    <Hr />

    <section id="news">
      <h2>News</h2>
      <div class="my-6">
        <Timeline />
      </div>
    </section>

    <Hr />

    <section id="publication">
      <h2>Selected Publications</h2>
      <ul class="my-6">
        {
          PUBLICATION.map(data => (
            <li class="mb-6 last:mb-0">
              <LinkButton
                className="text-skin-accent decoration-dashed hover:underline hover:underline-offset-4"
                href={data.url}
              >
                {data.title}
              </LinkButton>
              <p class="mt-1 text-sm italic">
                {data.authors.map((author, index) => (
                  <span
                    class={
                      DIMASNAMES.some(dims => dims.name === author)
                        ? "font-bold"
                        : "opacity-80"
                    }
                  >
                    {author + (index < data.authors.length - 1 ? ", " : "")}
                  </span>
                ))}
              </p>
              <div class="mt-1 text-sm">{data.conference}</div>
            </li>
          ))
        }
      </ul>
    </section>

    <Hr />

    <section id="research">
      <h2>Research</h2>
      <div class="my-6 space-y-6">
        <article>
          <h3 class="font-semibold">
            Software correctness across reimplementations
          </h3>
          <p class="mt-2">
            I investigate how LLMs can preserve useful semantic information when
            systems are reimplemented with entirely different designs or
            architectures. I have reviewed 12 reimplementation cases, including
            the SGLang router, Bun, and Vinext.
          </p>
        </article>
        <article>
          <h3 class="font-semibold">LISA: preventing regression failures</h3>
          <p class="mt-2">
            I lead the design and implementation of LISA, which uses LLMs to turn
            historical bug reports into low-level invariants. We identified 34 new
            bugs across ZooKeeper, HDFS, HBase, and Solr; 16 were confirmed by
            developers.
          </p>
          <p class="mt-2">
            I modified the JVM engine and built the invariant-checking pipeline
            using static analysis, concolic execution, and Z3. I also lead and
            mentor five research interns.
          </p>
        </article>
        <LinkButton
          href="/about/"
          className="text-skin-accent underline decoration-dashed underline-offset-4"
        >
          More about my background and experience
        </LinkButton>
      </div>
    </section>

    <Hr />

    <section id="services">
      <h2>Services</h2>
      <div class="my-6">
        {SERVICES.map((data) => (
          <div class="mb-2">
            <h3>{data.title}</h3>
            <ul class="list-disc ml-4">
              {data.services.map((service) => (
                <li>{service}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    {/* <Hr />

    {
      featuredPosts.length > 0 && (
        <>
          <section id="featured">
            <h2>Featured</h2>
            <ul>
              {featuredPosts.map(({ data, slug }) => (
                <Card
                  href={`/posts/${slug}/`}
                  frontmatter={data}
                  secHeading={false}
                />
              ))}
            </ul>
          </section>
          {recentPosts.length > 0 && <Hr />}
        </Hr>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts">
          <h2>Recent Posts</h2>
          <ul>
            {recentPosts.map(
              ({ data, slug }, index) =>
                index < 4 && (
                  <Card
                    href={`/posts/${slug}/`}
                    frontmatter={data}
                    secHeading={false}
                  />
                )
            )}
          </ul>
        </section>
      )
    }

    <div class="all-posts-btn-wrapper">
      <LinkButton href="/posts/">
        All Posts
        <svg xmlns="http://www.w3.org/2000/svg"
          ><path
            d="m11.293 17.293 1.414 1.414L19.414 12l-6.707-6.707-1.414 1.414L15.586 11H6v2h9.586z"
          ></path>
        </svg>
      </LinkButton>
    </div> */}
  </main>

  <Footer />
</Layout>

<style>
  /* ===== Hero Section ===== */
  #hero {
    @apply w-full py-8;
  }
  #hero h1 {
    @apply my-2 inline-block font-bold sm:my-4;
  }
  #hero .rss-link {
    @apply mb-6;
  }
  #hero .rss-icon {
    @apply mb-2 h-6 w-6 scale-110 fill-skin-accent sm:mb-3 sm:scale-125;
  }
  #hero p {
    @apply my-2;
  }
  .social-wrapper {
    @apply mt-4 flex flex-col sm:flex-row sm:items-center;
  }
  .social-links {
    @apply mb-1 mr-2 whitespace-nowrap sm:mb-0;
  }

  /* ===== Featured & Recent Posts Sections ===== */
  #featured,
  #recent-posts {
    @apply pb-6 pt-12;
  }
  #featured h2,
  #recent-posts h2 {
    @apply text-2xl font-semibold tracking-wide;
  }
  .all-posts-btn-wrapper {
    @apply my-8 text-center;
  }

  /* ===== Academic Profile Sections ===== */
  #news,
  #research,
  #publication,
  #services {
    @apply pb-6 pt-12;
  }
  #news h2,
  #research h2,
  #services h2,
  #publication h2 {
    @apply text-2xl font-semibold tracking-wide;
  }
</style>
